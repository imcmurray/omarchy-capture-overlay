#!/bin/bash
# Unit tests that do not need the compositor or a live picker.
set -u
PLUGIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
pass=0
fail=0

ok() { echo "PASS  $*"; pass=$((pass + 1)); }
bad() { echo "FAIL  $*"; fail=$((fail + 1)); }

echo "=== capture overlay core tests $(date) ==="

# --- leftover files and strings ---
for dead in cam-run cam-sidecar place-webcam stop-webcam pick-v4l2-mode cutout-cam blur-mask; do
  if [[ -e $PLUGIN_DIR/bin/$dead ]]; then
    bad "leftover script still present: bin/$dead"
  else
    ok "removed leftover bin/$dead"
  fi
done

if grep -R -n --include='*.qml' --include='*.js' --include='*.sh' --exclude='test-*' -E 'MediaRecorder|startSidecar|stopSidecar|camSidecar|REAL_MPV|cam_place|cam_park_xy|has_sidecar' "$PLUGIN_DIR" >/tmp/ianm-core-grep.txt 2>/dev/null; then
  bad "leftover sidecar/mpv symbols:"
  cat /tmp/ianm-core-grep.txt
else
  ok "no sidecar/mpv symbols in plugin sources"
fi

if grep -R -n --include='*.qml' --include='*.js' --include='*.sh' --include='*.lua' --exclude='test-*' -E 'systemctl|sudo|pkexec' "$PLUGIN_DIR" >/tmp/ianm-priv-grep.txt 2>/dev/null; then
  bad "privilege or service-management strings:"
  cat /tmp/ianm-priv-grep.txt
else
  ok "no sudo, pkexec, or systemctl in plugin sources"
fi

if grep -R -n --include='*.qml' --include='*.sh' 'WebcamOverlay' "$PLUGIN_DIR" >/dev/null; then
  bad "plugin still mentions stock WebcamOverlay"
else
  ok "plugin does not match stock WebcamOverlay"
fi

if grep -n 'PATH=.*mpv\|bin/mpv' "$PLUGIN_DIR/record.sh" >/dev/null; then
  bad "record.sh still PATH-wraps mpv"
else
  ok "record.sh does not PATH-wrap mpv"
fi

python3 - "$PLUGIN_DIR/config/omarchy-menu.jsonc" <<'PY' && ok "menu snippet adds overlay without replacing stock webcam" || bad "menu snippet still hijacks stock screenrecord rows"
import json, re, sys
from pathlib import Path
raw = Path(sys.argv[1]).read_text()
raw = re.sub(r"/\*.*?\*/", "", raw, flags=re.S)
raw = re.sub(r"^\s*//.*$", "", raw, flags=re.M)
raw = re.sub(r",(\s*[}\]])", r"\1", raw)
m = json.loads(raw)
assert "trigger.capture.screenrecord.overlay" in m, m.keys()
row = m["trigger.capture.screenrecord.overlay"]
assert row.get("label") == "With overlay + desktop + microphone audio", row
assert "--with-webcam" in row.get("action", ""), row
assert "ianm.capture-overlay/record.sh" in row.get("action", ""), row
assert row.get("when") == "omarchy-hw-webcam", row
stop = m.get("trigger.capture.screenrecord.stop") or {}
assert stop.get("label") == "Stop Screenrecording", stop
assert "ianm.capture-overlay/record.sh --stop-recording" in stop.get("action", ""), stop
for stock in (
    "trigger.capture.screenrecord.no-audio",
    "trigger.capture.screenrecord.desktop-audio",
    "trigger.capture.screenrecord.microphone",
    "trigger.capture.screenrecord.webcam",
):
    assert stock not in m, stock
PY

if grep -q 'function newPickSession' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'pickSession' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'function runtimeIo' "$PLUGIN_DIR/Service.qml" \
  && ! grep -q 'parsed.selectionFile' "$PLUGIN_DIR/Service.qml" \
  && ! grep -q 'parsed.doneFile' "$PLUGIN_DIR/Service.qml"; then
  ok "pick IPC does not take caller file paths"
else
  bad "pick IPC still accepts caller selectionFile/doneFile"
fi

if grep -q 'property bool pickerScrim' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'pickPhase === "shape" || root.cameraMenuOpen' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'property real scrimAmount' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'Behavior on scrimAmount' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'opacity: root.scrimAmount' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'ianm-capture-live' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'live.holeX + live.holeW' "$PLUGIN_DIR/Service.qml" \
  && ! grep -q 'id: liveDim' "$PLUGIN_DIR/Service.qml"; then
  ok "picker scrim tweens in and out; live dim leaves the grab clear"
else
  bad "picker scrim tween or live overlay namespace is missing"
fi

if grep -q 'blur = true' "$PLUGIN_DIR/config/hyprland.lua" \
  && grep -q 'ignore_alpha' "$PLUGIN_DIR/config/hyprland.lua"; then
  ok "hyprland snippet blurs the overlay dim"
else
  bad "hyprland snippet is missing overlay blur"
fi

if grep -q 'property bool camDragging' "$PLUGIN_DIR/Service.qml" \
  && grep -n 'mask:' "$PLUGIN_DIR/Service.qml" | grep -q camDragging \
  && grep -q 'onCanceled: root.finishCamDrag' "$PLUGIN_DIR/Service.qml"; then
  ok "pip drag freezes the input mask so a fast move cannot drop the grab"
else
  bad "pip drag is still tied to a moving pip-sized input mask"
fi

if grep -q 'function pickCamFormat' "$PLUGIN_DIR/CamPreview.qml" \
  && grep -q 'cameraFormat:' "$PLUGIN_DIR/CamPreview.qml" \
  && grep -q 'function matchDevice' "$PLUGIN_DIR/CamPreview.qml" \
  && grep -q 'defaultVideoInput' "$PLUGIN_DIR/CamPreview.qml"; then
  ok "camera matches a saved device, then the system default, at 24fps+ / 720p"
else
  bad "camera still hardcodes a device or skips format pick"
fi

if grep -q 'function setCamera' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'cameraMenuOpen' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'showCamPick' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'id: camPick' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'readonly property alias cameraModel' "$PLUGIN_DIR/CamPreview.qml" \
  && grep -q 'cameraId: root.cameraId' "$PLUGIN_DIR/Service.qml"; then
  ok "place preview can pick among cameras from a menu under the pip"
else
  bad "camera picker is missing from the place preview"
fi

if grep -q 'property int pipBorderWidth' "$PLUGIN_DIR/CamPreview.qml" \
  && grep -q 'border.color: root.pipBorderColor' "$PLUGIN_DIR/CamPreview.qml" \
  && grep -q 'setPipBorderColor' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'component PipBorderSwatch' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'component PipWidthChip' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'colorKey: "magenta"' "$PLUGIN_DIR/Service.qml"; then
  ok "pip border color and thickness apply on the shape panel"
else
  bad "pip border is still circle-only or not user-assignable"
fi

if grep -q 'shapeKey: "square"' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'shapeKey: "oval"' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'webcamShape === "oval"' "$PLUGIN_DIR/CamPreview.qml" \
  && ! grep -q 'cutout' "$PLUGIN_DIR/Service.qml" \
  && ! grep -q 'PersonCutout' "$PLUGIN_DIR/CamPreview.qml"; then
  ok "webcam shapes are rectangle, square, circle, and oval"
else
  bad "webcam shapes still include cutout or are missing square/oval"
fi

if grep -q 'function cropCamFrom' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'function setCamRot' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'camInsetL' "$PLUGIN_DIR/CamPreview.qml" \
  && grep -q 'showHandles' "$PLUGIN_DIR/Service.qml"; then
  ok "place preview handles crop the video inside the shape"
else
  bad "pip crop handles are missing"
fi

if grep -q 'function backToShapePanel' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'Esc to go back' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'pickPhase !== "shape"' "$PLUGIN_DIR/Service.qml"; then
  ok "place phase can return to the options panel"
else
  bad "no way back from place to the options panel"
fi

python3 - "$PLUGIN_DIR/Service.qml" <<'PY' && ok "options panel is fade, border, corners, then click-a-shape" || bad "shape cards are still above fade/border/corners"
from pathlib import Path
import sys
text = Path(sys.argv[1]).read_text()
sp = text.index("id: shapePanel")
fade = text.index('label: "Fade in"', sp)
border = text.index('text: "Border"', sp)
corners = text.index('text: "Corners"', sp)
click = text.index('text: "Click a shape to continue"', sp)
rect = text.index('shapeKey: "rectangle"', sp)
assert fade < border < corners < click < rect, (fade, border, corners, click, rect)
PY

if grep -q 'label: "Show keys"' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'component KeyHud' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'function noteKey' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'input.keyboard.key' "$PLUGIN_DIR/config/bindings.lua" \
  && grep -q 'ianm-capture-overlay/keys' "$PLUGIN_DIR/config/bindings.lua" \
  && grep -q 'pcall' "$PLUGIN_DIR/config/bindings.lua"; then
  ok "show-keys HUD is an option on the shape panel"
else
  bad "show-keys overlay is missing"
fi

if grep -q 'function setPipCornerFrac' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'component CornerSlider' "$PLUGIN_DIR/Service.qml" \
  && grep -q 'property real pipRadius' "$PLUGIN_DIR/CamPreview.qml" \
  && grep -q 'needsMask' "$PLUGIN_DIR/CamPreview.qml" \
  && grep -q 'function cornerPx' "$PLUGIN_DIR/PickerModel.js"; then
  ok "shape panel can set a corner radius on rectangle and square"
else
  bad "corner radius control is missing"
fi

# --- cam-lib geometry ---
work=$(mktemp -d)
export XDG_RUNTIME_DIR=$work
# shellcheck disable=SC1091
source "$PLUGIN_DIR/bin/cam-lib"

SHAPE=rectangle
cam_fill_from_region 10 20 1920 1080
if [[ $CAM_X == 10 && $CAM_Y == 20 && $CAM_W == 1920 && $CAM_H == 1080 && $REL_X == 0 && $REL_Y == 0 ]]; then
  ok "rectangle pip fills the grab"
else
  bad "rectangle pip geometry: $CAM_X,$CAM_Y ${CAM_W}x${CAM_H} rel=$REL_X,$REL_Y"
fi

SHAPE=circle
cam_fill_from_region 100 200 1920 1080
if [[ $CAM_W == 1080 && $CAM_H == 1080 && $CAM_X == $((100 + (1920 - 1080) / 2)) && $CAM_Y == 200 ]]; then
  ok "circle pip is a centered square in the grab"
else
  bad "circle pip geometry: $CAM_X,$CAM_Y ${CAM_W}x${CAM_H}"
fi

SHAPE=square
cam_fill_from_region 100 200 1920 1080
if [[ $CAM_W == 1080 && $CAM_H == 1080 && $CAM_X == $((100 + (1920 - 1080) / 2)) ]]; then
  ok "square pip is a centered square in the grab"
else
  bad "square pip geometry: $CAM_X,$CAM_Y ${CAM_W}x${CAM_H}"
fi

SHAPE=oval
cam_fill_from_region 10 20 1920 1080
if [[ $CAM_X == 10 && $CAM_Y == 20 && $CAM_W == 1920 && $CAM_H == 1080 ]]; then
  ok "oval pip fills the grab"
else
  bad "oval pip geometry: $CAM_X,$CAM_Y ${CAM_W}x${CAM_H}"
fi

SHAPE=circle
cam_fill_from_region 100 200 1920 1080
FADE_IN=1 FADE_OUT=0 FADE_SEC=2.5
cam_save
unset SHAPE REGION_X CAM_W FADE_IN FADE_OUT FADE_SEC
cam_load || { bad "cam_load failed after cam_save"; }
if [[ $SHAPE == circle && $FADE_IN == 1 && $FADE_OUT == 0 && $CAM_W == 1080 ]]; then
  ok "cam_save/cam_load round-trip"
else
  bad "recipe round-trip SHAPE=$SHAPE FADE_IN=$FADE_IN CAM_W=$CAM_W"
fi

if printf 'SHAPE=$(touch /tmp/ianm-pwned)\nFADE_IN=1\n' >"$RECIPE" \
  && ! cam_load 2>/dev/null; then
  ok "cam_load rejects shell syntax in the recipe"
else
  bad "cam_load accepted a recipe with shell metacharacters"
fi
rm -f /tmp/ianm-pwned

python3 - "$RECIPE" <<'PY'
import os, sys
os.remove(sys.argv[1])
os.symlink("/etc/passwd", sys.argv[1])
PY
if cam_load 2>/dev/null; then
  bad "cam_load followed a recipe symlink"
else
  ok "cam_load refuses a recipe symlink"
fi

# --- start-cam / cam-update ---
"$PLUGIN_DIR/bin/start-cam" rectangle "640x360+40+80" 1 1
cam_load || { bad "cam_load failed after start-cam"; }
if [[ $REGION_X == 40 && $REGION_Y == 80 && $REGION_W == 640 && $REGION_H == 360 && $FADE_IN == 1 && $FADE_OUT == 1 && $CAM_X == 40 ]]; then
  ok "start-cam writes grab, pip, and fade flags"
else
  bad "start-cam recipe REGION=$REGION_X,$REGION_Y ${REGION_W}x${REGION_H} CAM=$CAM_X FADE=$FADE_IN/$FADE_OUT"
fi

"$PLUGIN_DIR/bin/cam-update" 50 90 200 120
cam_load || { bad "cam_load failed after cam-update"; }
if [[ $CAM_X == 50 && $CAM_Y == 90 && $CAM_W == 200 && $CAM_H == 120 && $REL_X == 10 && $REL_Y == 10 ]]; then
  ok "cam-update persists dragged pip geometry"
else
  bad "cam-update CAM=$CAM_X,$CAM_Y ${CAM_W}x${CAM_H} rel=$REL_X,$REL_Y"
fi

# --- finish-pick ---
session=0123456789abcdef
if "$PLUGIN_DIR/bin/finish-pick" "../etc" "40,80 640x360" ok rectangle 1 0 2>/tmp/ianm-pick-evil.err; then
  bad "finish-pick accepted a path-like session"
else
  ok "finish-pick rejects a path-like session"
fi

"$PLUGIN_DIR/bin/finish-pick" "$session" "40,80 640x360" ok rectangle 1 0
cam_load || { bad "cam_load failed after finish-pick"; }
pick_out=$(runtime_io read-pick "$session") || { bad "read-pick failed after finish-pick ok"; pick_out=""; }
if [[ $FADE_IN == 1 && $FADE_OUT == 0 && $pick_out == $'ok\n40,80 640x360\nrectangle' ]]; then
  ok "finish-pick ok writes geo, shape, and fade flags"
else
  bad "finish-pick ok FADE=$FADE_IN/$FADE_OUT pick=$(printf %q "$pick_out")"
fi
if runtime_io read-pick "$session" 2>/dev/null; then
  bad "read-pick did not consume the session files"
else
  ok "read-pick removes session files after consumption"
fi

session2=fedcba9876543210
"$PLUGIN_DIR/bin/finish-pick" "$session2" "" cancel "" 0 0
pick_out=$(runtime_io read-pick "$session2") || { bad "read-pick failed after cancel"; pick_out=""; }
if [[ ! -f $RECIPE && $pick_out == cancel ]]; then
  ok "finish-pick cancel drops the recipe"
else
  bad "finish-pick cancel left RECIPE=$([[ -f $RECIPE ]] && echo yes || echo no) pick=$(printf %q "$pick_out")"
fi

rc=0
runtime_io read-pick 0123456789abcdef 2>/dev/null || rc=$?
if [[ $rc == 3 ]]; then
  ok "read-pick exits 3 when the session is missing"
else
  bad "read-pick missing exit $rc (want 3)"
fi

ln -sf /etc/passwd "$RUNTIME/p-aaaaaaaaaaaaaaaa.done"
if runtime_io read-pick aaaaaaaaaaaaaaaa 2>/dev/null; then
  bad "read-pick followed a done symlink"
else
  ok "read-pick refuses a done symlink"
fi

runtime_io set-flag keys.on
if [[ -f $RUNTIME/keys.on && ! -L $RUNTIME/keys.on && $(<"$RUNTIME/keys.on") == 1 ]]; then
  ok "set-flag writes keys.on as a regular file"
else
  bad "set-flag did not write keys.on"
fi
runtime_io clear-flag keys.on
if [[ ! -e $RUNTIME/keys.on ]]; then
  ok "clear-flag removes keys.on"
else
  bad "clear-flag left keys.on"
fi

if grep -n 'bash", "-c"' "$PLUGIN_DIR/Service.qml" \
  || grep -n '/tmp/omarchy-screenrecord-filename' "$PLUGIN_DIR/Service.qml" "$PLUGIN_DIR/record.sh" \
  || grep -n 'omarchy-capture-keys.on' "$PLUGIN_DIR/Service.qml"; then
  bad "Service.qml or record.sh still uses bash -c or /tmp filename paths"
else
  ok "keys marker and stock filename go through runtime-io"
fi

if grep -n 'p-\${session}' "$PLUGIN_DIR/pick.sh" \
  || grep -n 'donef=' "$PLUGIN_DIR/pick.sh"; then
  bad "pick.sh still reads session files by pathname"
else
  ok "pick.sh consumes results through read-pick"
fi

# --- compose-cam fades ---
clip=$work/clip.mp4
if ffmpeg -hide_banner -loglevel error -y \
  -f lavfi -i color=c=white:s=320x180:d=5:r=30 \
  -f lavfi -i sine=frequency=1000:duration=5 \
  -c:v libx264 -pix_fmt yuv420p -preset ultrafast -c:a aac -shortest "$clip"
then
  FADE_IN=1 FADE_OUT=1 FADE_SEC=1.0 SHAPE=rectangle
  REGION_X=0 REGION_Y=0 REGION_W=320 REGION_H=180
  CAM_X=0 CAM_Y=0 CAM_W=320 CAM_H=180 REL_X=0 REL_Y=0
  cam_save
  IANM_CAPTURE_TEST=1 "$PLUGIN_DIR/bin/compose-cam" "$clip"
  luma=$(python3 - "$clip" <<'PY'
import subprocess, sys
path = sys.argv[1]

def mean(t):
    p = subprocess.run(
        ["ffmpeg", "-hide_banner", "-loglevel", "error", "-ss", str(t), "-i", path,
         "-frames:v", "1", "-f", "rawvideo", "-pix_fmt", "gray", "pipe:1"],
        capture_output=True,
    )
    d = p.stdout
    return (sum(d) / len(d)) if d else -1

print(f"{mean(0):.1f} {mean(2.5):.1f} {mean(4.95):.1f}")
PY
)
  read -r l0 lmid lend <<<"$luma"
  if awk -v a="$l0" -v b="$lmid" -v c="$lend" 'BEGIN { exit !((a+0) < 40 && (b+0) > 180 && (c+0) < 40) }'; then
    ok "compose-cam fades white clip to black at both ends (luma $luma)"
  else
    bad "compose-cam fade luma expected low/high/low, got $luma"
  fi
  if [[ -f $RECIPE ]]; then
    bad "compose-cam left the recipe file behind"
  else
    ok "compose-cam removes the recipe after render"
  fi
else
  bad "could not generate a test clip with ffmpeg"
fi

none=$work/plain.mp4
ffmpeg -hide_banner -loglevel error -y -f lavfi -i color=c=white:s=160x90:d=1:r=30 \
  -c:v libx264 -pix_fmt yuv420p -preset ultrafast -an "$none" >/dev/null
before=$(stat -c %s "$none")
IANM_CAPTURE_TEST=1 "$PLUGIN_DIR/bin/compose-cam" "$none"
after=$(stat -c %s "$none")
if [[ $before == "$after" ]]; then
  ok "compose-cam is a no-op without a recipe"
else
  bad "compose-cam rewrote a file with no recipe ($before -> $after)"
fi

# --- PickerModel.js ---
if PICKER="$PLUGIN_DIR/PickerModel.js" node <<'JS'
const fs = require("fs");
const src = fs.readFileSync(process.env.PICKER, "utf8").replace(/^\.pragma library\s*/, "");
eval(src);
function assert(cond, msg) {
  if (!cond) {
    console.error(msg);
    process.exit(1);
  }
}
const r = clampRect({ x: -10, y: -10, w: 50, h: 50 }, 0, 0, 100, 100);
assert(r.x === 0 && r.y === 0 && r.w >= 32 && r.h >= 32, "clampRect should stay on screen");
const guides = [
  { x: 0, y: 0, w: 1920, h: 1080, label: "1080p" },
  { x: 0, y: 0, w: 1280, h: 720, label: "720p" },
];
const snapped = snapToGhosts({ x: 0, y: 0, w: 1910, h: 1070 }, guides, 32);
assert(snapped.snapped === "1080p" && snapped.w === 1920 && snapped.h === 1080, "snapToGhosts 1080p");
assert(matchingLabel({ w: 1280, h: 720 }) === "720p", "matchingLabel 720p");
assert(hitHandle(0, 0, { x: 0, y: 0, w: 100, h: 80 }) === "nw", "hitHandle nw");
assert(hitHandle(50, 0, { x: 0, y: 0, w: 100, h: 80 }) === "n", "hitHandle n");
const resized = resize({ x: 10, y: 10, w: 100, h: 80 }, "se", 200, 200);
assert(resized.w === 190 && resized.h === 190, "resize se");
const moved = move({ x: 10, y: 20, w: 30, h: 40 }, 5, -2);
assert(moved.x === 15 && moved.y === 18, "move");
assert(inside(15, 15, { x: 10, y: 10, w: 20, h: 20 }), "inside");
assert(!inside(5, 5, { x: 10, y: 10, w: 20, h: 20 }), "outside");
assert(cursorForHandle("nw") === "nwse" && cursorForHandle("n") === "ns", "cursorForHandle");
const vis = visibleGhosts(guides, { x: 0, y: 0, w: 1920, h: 1080 });
assert(vis.length === 1 && vis[0].label === "720p", "visibleGhosts hides current");
assert(sanitizeBorderColor("red") === "red", "sanitizeBorderColor red");
assert(sanitizeBorderColor("white") === "accent", "old white maps to accent");
assert(sanitizeBorderColor("urgent") === "red", "old urgent maps to red");
assert(sanitizeBorderColor("nope") === "accent", "sanitizeBorderColor fallback");
assert(sanitizeBorderWidth("thick") === "thick", "sanitizeBorderWidth thick");
assert(sanitizeBorderWidth("") === "medium", "sanitizeBorderWidth fallback");
assert(borderWidthLabel("off") === "Off", "borderWidthLabel off");
assert(BORDER_COLORS.length === 7 && BORDER_WIDTHS.length === 4, "border palettes");
assert(sanitizeWebcamShape("oval") === "oval", "sanitizeWebcamShape oval");
assert(sanitizeWebcamShape("cutout") === "rectangle", "old cutout maps to rectangle");
assert(sanitizeWebcamShape("blob") === "rectangle", "sanitizeWebcamShape fallback");
assert(isSquarePip("square") && isSquarePip("circle") && !isSquarePip("oval"), "isSquarePip");
assert(isRoundPip("circle") && isRoundPip("oval") && !isRoundPip("square"), "isRoundPip");
assert(usesCornerRadius("rectangle") && usesCornerRadius("square") && !usesCornerRadius("circle"), "usesCornerRadius");
assert(sanitizeCornerFrac(-1) === 0 && sanitizeCornerFrac(1) === 0.5, "sanitizeCornerFrac clamp");
assert(cornerPx(0.5, 100, 80) === 40 && cornerPx(0, 100, 80) === 0, "cornerPx");
assert(formatKeyChord(true, false, false, false, "C") === "Super + C", "formatKeyChord Super+C");
assert(formatKeyChord(false, false, false, false, "C") === "", "formatKeyChord hides bare letters");
assert(formatKeyChord(false, false, false, false, "F5") === "F5", "formatKeyChord bare function key");
assert(formatKeyChord(false, true, false, true, "P") === "Ctrl + Shift + P", "formatKeyChord Ctrl+Shift+P");
assert(cycleWebcamShape("rectangle", 1) === "square", "cycleWebcamShape next");
assert(cycleWebcamShape("oval", 1) === "rectangle", "cycleWebcamShape wrap");
const pal = parseThemePalette('accent = "#89b4fa"\nred = "#f38ba8"\nyellow = "#f9e2af"\n');
assert(pal.accent === "#89b4fa" && pal.red === "#f38ba8", "parseThemePalette");
assert(themeBorderColor("yellow", pal) === "#f9e2af", "themeBorderColor yellow");
const grayPal = parseThemePalette('red = "#565d60"\nbright_red = "#de6145"\n');
assert(themeBorderColor("red", grayPal) === "#de6145", "themeBorderColor prefers brighter red");
process.exit(0);
JS
then
  ok "PickerModel clamp/snap/hit/resize"
else
  bad "PickerModel.js unit tests"
fi

# --- wrappers ---
if "$PLUGIN_DIR/bin/omarchy-capture-webcam-resize" 2>/dev/null; then
  bad "resize wrapper accepted a missing action"
else
  ok "resize wrapper rejects a missing action"
fi

if "$PLUGIN_DIR/record.sh" --stop-recording >/tmp/ianm-stop-idle.out 2>/tmp/ianm-stop-idle.err; then
  bad "record.sh --stop-recording exited 0 while idle (menu || would not open)"
else
  ok "record.sh --stop-recording exits nonzero when nothing is recording"
fi

rm -rf "$work"

echo
echo "=== $pass passed, $fail failed (core) ==="
exit $((fail > 0 ? 1 : 0))
