#!/bin/bash
# Best-effort cleanup. The live preview is torn down by unloading CamPreview.qml;
# this only clears leftover units from older plugin versions.
set -euo pipefail
systemctl --user stop ianm-cam.service ianm-cam-sidecar.service 2>/dev/null || true
systemctl --user reset-failed ianm-cam.service ianm-cam-sidecar.service 2>/dev/null || true
