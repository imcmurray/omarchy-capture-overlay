#!/bin/bash
# Encode the camera to a sidecar after preview has released /dev/video0.
set -euo pipefail
PLUGIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck disable=SC1091
source "$PLUGIN_DIR/bin/cam-lib"
cam_load || exit 1

fmt="" size="" fps=""
IFS=',' read -ra parts <<<"${LAVF:-}"
for p in "${parts[@]}"; do
  case "$p" in
  input_format=*) fmt=${p#input_format=} ;;
  video_size=*) size=${p#video_size=} ;;
  framerate=*) fps=${p#framerate=} ;;
  esac
done
[[ -n $size ]] || size=640x360
[[ -n $fps ]] || fps=30
[[ -n ${DEVICE:-} ]] || exit 1

fmt_args=()
[[ -n $fmt ]] && fmt_args=(-input_format "$fmt")
log=$RUNTIME/omarchy-cam-ffmpeg.log
: >"$log"
rm -f "$SIDECAR"

sleep 0.2
exec /usr/bin/ffmpeg -hide_banner -loglevel warning \
  -fflags nobuffer -flags low_delay -probesize 32 -analyzeduration 0 \
  -f v4l2 -video_size "$size" -framerate "$fps" "${fmt_args[@]}" \
  -thread_queue_size 2 -i "$DEVICE" \
  -an -c:v libx264 -preset ultrafast -tune zerolatency -g 30 -pix_fmt yuv420p \
  "$SIDECAR" >>"$log" 2>&1
