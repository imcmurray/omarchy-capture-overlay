#!/bin/bash
# Shared paths and geometry for the capture-overlay camera.
# Sourced by other scripts; not launched directly.

RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
RECIPE="$RUNTIME/omarchy-cam-mix.env"
FIFO="$RUNTIME/omarchy-cam-preview.y4m"
SIDECAR="$RUNTIME/omarchy-cam-sidecar.mp4"
FF_PIDFILE="$RUNTIME/omarchy-cam-ffmpeg.pid"
MPV_PIDFILE="$RUNTIME/omarchy-cam-mpv.pid"
WIN='class:ianm.cam-preview'
REAL_MPV=/usr/bin/mpv
MARGIN=16

cam_load() {
  [[ -f $RECIPE ]] || return 1
  # shellcheck disable=SC1090
  source "$RECIPE"
}

cam_save() {
  cat >"$RECIPE" <<EOF
SHAPE=${SHAPE:-rectangle}
REGION_X=${REGION_X:-0}
REGION_Y=${REGION_Y:-0}
REGION_W=${REGION_W:-0}
REGION_H=${REGION_H:-0}
CAM_X=${CAM_X:-0}
CAM_Y=${CAM_Y:-0}
CAM_W=${CAM_W:-0}
CAM_H=${CAM_H:-0}
REL_X=${REL_X:-0}
REL_Y=${REL_Y:-0}
PARK_X=${PARK_X:-0}
PARK_Y=${PARK_Y:-0}
DEVICE=${DEVICE:-}
LAVF=${LAVF:-input_format=yuyv422,video_size=640x360,framerate=30}
SIDECAR=$SIDECAR
FIFO=$FIFO
FF_PIDFILE=$FF_PIDFILE
MPV_PIDFILE=$MPV_PIDFILE
OFFSET_SEC=${OFFSET_SEC:-0.12}
EOF
}

cam_fill_from_region() {
  local rx=$1 ry=$2 rw=$3 rh=$4
  REGION_X=$rx REGION_Y=$ry REGION_W=$rw REGION_H=$rh
  if [[ ${SHAPE:-rectangle} == circle ]]; then
    local side=$rw
    ((rh < side)) && side=$rh
    ((side < 48)) && side=48
    CAM_W=$side
    CAM_H=$side
    CAM_X=$((rx + (rw - side) / 2))
    CAM_Y=$((ry + (rh - side) / 2))
  else
    CAM_W=$rw
    CAM_H=$rh
    CAM_X=$rx
    CAM_Y=$ry
    ((CAM_W < 48)) && CAM_W=48
    ((CAM_H < 48)) && CAM_H=48
  fi
  REL_X=$((CAM_X - REGION_X))
  REL_Y=$((CAM_Y - REGION_Y))
}

cam_park_xy() {
  local mon_x=0 mon_y=0 mon_w=3440 mon_h=1440
  read -r mon_x mon_y mon_w mon_h < <(hyprctl monitors -j 2>/dev/null | jq -r '
    first(.[] | select(.focused == true) // .[0])
    | "\(.x) \(.y) \((.width / .scale) | floor) \((.height / .scale) | floor)"
  ' 2>/dev/null || echo "0 0 3440 1440")
  if ((REGION_X + REGION_W + MARGIN + CAM_W <= mon_x + mon_w)); then
    PARK_X=$((REGION_X + REGION_W + MARGIN))
    PARK_Y=$CAM_Y
  elif ((REGION_X - MARGIN - CAM_W >= mon_x)); then
    PARK_X=$((REGION_X - MARGIN - CAM_W))
    PARK_Y=$CAM_Y
  else
    PARK_X=$CAM_X
    PARK_Y=$((REGION_Y + REGION_H + MARGIN))
  fi
}

cam_place() {
  local x=$1 y=$2 w=$3 h=$4
  ((w < 48)) && w=48
  ((h < 48)) && h=48
  hyprctl eval "hl.dispatch(hl.dsp.window.float({ window = \"$WIN\", action = \"on\" }))"
  hyprctl eval "hl.dispatch(hl.dsp.window.resize({ window = \"$WIN\", x = $w, y = $h, relative = false }))"
  hyprctl eval "hl.dispatch(hl.dsp.window.move({ window = \"$WIN\", x = $x, y = $y, relative = false }))"
}
