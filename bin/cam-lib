#!/bin/bash
# Shared paths and geometry for the capture-overlay camera.
# Sourced by other scripts; not launched directly.

RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
RECIPE="$RUNTIME/omarchy-cam-mix.env"

cam_load() {
  [[ -f $RECIPE ]] || return 1
  # shellcheck disable=SC1090
  source "$RECIPE"
}

cam_save() {
  cat >"$RECIPE" <<EOF
SHAPE=${SHAPE:-rectangle}
REGION_X=${REGION_X:-0}
REGION_Y=${REGION_Y:-0}
REGION_W=${REGION_W:-0}
REGION_H=${REGION_H:-0}
CAM_X=${CAM_X:-0}
CAM_Y=${CAM_Y:-0}
CAM_W=${CAM_W:-0}
CAM_H=${CAM_H:-0}
CAM_ROT=${CAM_ROT:-0}
REL_X=${REL_X:-0}
REL_Y=${REL_Y:-0}
FADE_IN=${FADE_IN:-0}
FADE_OUT=${FADE_OUT:-0}
FADE_SEC=${FADE_SEC:-2.5}
EOF
}

cam_fill_from_region() {
  local rx=$1 ry=$2 rw=$3 rh=$4
  REGION_X=$rx REGION_Y=$ry REGION_W=$rw REGION_H=$rh
  case ${SHAPE:-rectangle} in
  circle | square)
    local side=$rw
    ((rh < side)) && side=$rh
    ((side < 48)) && side=48
    CAM_W=$side
    CAM_H=$side
    CAM_X=$((rx + (rw - side) / 2))
    CAM_Y=$((ry + (rh - side) / 2))
    ;;
  *)
    CAM_W=$rw
    CAM_H=$rh
    CAM_X=$rx
    CAM_Y=$ry
    ((CAM_W < 48)) && CAM_W=48
    ((CAM_H < 48)) && CAM_H=48
    ;;
  esac
  REL_X=$((CAM_X - REGION_X))
  REL_Y=$((CAM_Y - REGION_Y))
}
