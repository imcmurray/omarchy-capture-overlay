#!/bin/bash
# On success: persist region and fade flags. On cancel: drop the recipe.
set -euo pipefail

PLUGIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck disable=SC1091
source "$PLUGIN_DIR/bin/cam-lib"

geo=${1:-}
sel=${2:-}
status=${3:-cancel}
done=${4:-}
shape=${5:-}
fade_in=${6:-0}
fade_out=${7:-0}

if [[ $status == ok ]]; then
  if cam_load; then
    [[ -n $shape ]] && SHAPE=$shape
    FADE_IN=$fade_in
    FADE_OUT=$fade_out
    FADE_SEC=${FADE_SEC:-2.5}
    if [[ $geo =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]]; then
      REGION_X=${BASH_REMATCH[1]}
      REGION_Y=${BASH_REMATCH[2]}
      REGION_W=${BASH_REMATCH[3]}
      REGION_H=${BASH_REMATCH[4]}
    fi
    REL_X=$((CAM_X - REGION_X))
    REL_Y=$((CAM_Y - REGION_Y))
    cam_save
  fi
else
  "$PLUGIN_DIR/bin/stop-cam"
  rm -f "$RECIPE"
fi

printf '%s\n' "$geo" >"$sel"
if [[ -n $shape ]]; then
  printf '%s\n' "$shape" >>"$sel"
fi
printf '%s\n' "$status" >"$done"
