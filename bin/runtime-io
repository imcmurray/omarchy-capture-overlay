#!/usr/bin/python3
"""Atomic, no-follow I/O under $XDG_RUNTIME_DIR/ianm-capture-overlay."""

from __future__ import annotations

import os
import re
import stat
import sys

DIR_NAME = "ianm-capture-overlay"
RECIPE_NAME = "recipe"
KEYS_FLAG = "keys.on"
STOCK_DIR = "/tmp"
STOCK_NAME = "omarchy-screenrecord-filename"
MAX_RECIPE = 4096
MAX_PICK = 256
MAX_POINTER = 4096
SESSION_RE = re.compile(r"^[0-9a-f]{16,32}$")
PICK_STATUS = {"ok", "cancel"}
SHAPE = {"", "rectangle", "square", "circle", "oval"}
GEO_RE = re.compile(r"^-?\d+,-?\d+ \d+x\d+$")
VIDEO_RE = re.compile(r"^/[A-Za-z0-9._/+-]+\.mp4$")
OPEN_READ = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC
OPEN_DIR = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC

RECIPE_FIELDS = {
    "SHAPE": re.compile(r"^(rectangle|square|circle|oval)$"),
    "REGION_X": re.compile(r"^-?\d+$"),
    "REGION_Y": re.compile(r"^-?\d+$"),
    "REGION_W": re.compile(r"^\d+$"),
    "REGION_H": re.compile(r"^\d+$"),
    "CAM_X": re.compile(r"^-?\d+$"),
    "CAM_Y": re.compile(r"^-?\d+$"),
    "CAM_W": re.compile(r"^\d+$"),
    "CAM_H": re.compile(r"^\d+$"),
    "CAM_ROT": re.compile(r"^-?\d+(\.\d+)?$"),
    "REL_X": re.compile(r"^-?\d+$"),
    "REL_Y": re.compile(r"^-?\d+$"),
    "FADE_IN": re.compile(r"^[01]$"),
    "FADE_OUT": re.compile(r"^[01]$"),
    "FADE_SEC": re.compile(r"^\d+(\.\d+)?$"),
}


def fail(msg: str, code: int = 1) -> None:
    if msg:
        print(msg, file=sys.stderr)
    raise SystemExit(code)


def missing() -> None:
    raise SystemExit(3)


def check_name(name: str) -> None:
    if not name or name in (".", "..") or "/" in name or "\0" in name:
        fail("invalid file name")


def owned_regular(fd: int, max_bytes: int) -> os.stat_result:
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid():
        fail("refusing file that is not a user-owned regular file")
    if st.st_size > max_bytes:
        fail("file too large")
    return st


def open_runtime_dir() -> int:
    xdg = os.environ.get("XDG_RUNTIME_DIR", "")
    if not xdg:
        fail("XDG_RUNTIME_DIR is unset")
    try:
        root_fd = os.open(xdg, OPEN_DIR | os.O_NOFOLLOW)
    except OSError as e:
        fail(f"XDG_RUNTIME_DIR: {e}")
    try:
        try:
            os.mkdir(DIR_NAME, 0o700, dir_fd=root_fd)
        except FileExistsError:
            pass
        fd = os.open(DIR_NAME, OPEN_DIR | os.O_NOFOLLOW, dir_fd=root_fd)
    except OSError as e:
        os.close(root_fd)
        fail(f"runtime dir: {e}")
    os.close(root_fd)
    st = os.fstat(fd)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        os.close(fd)
        fail("runtime dir is not a user-owned directory")
    os.fchmod(fd, 0o700)
    return fd


def atomic_write(dir_fd: int, name: str, data: bytes) -> None:
    check_name(name)
    tmp = f".{name}.tmp.{os.getpid()}"
    fd = os.open(
        tmp,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
        0o600,
        dir_fd=dir_fd,
    )
    try:
        os.write(fd, data)
        os.fsync(fd)
    finally:
        os.close(fd)
    try:
        os.replace(tmp, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
    except Exception:
        try:
            os.unlink(tmp, dir_fd=dir_fd)
        except OSError:
            pass
        raise


def read_named(dir_fd: int, name: str, max_bytes: int) -> bytes:
    check_name(name)
    try:
        fd = os.open(name, OPEN_READ, dir_fd=dir_fd)
    except FileNotFoundError:
        missing()
    except OSError as e:
        fail(str(e))
    try:
        st = owned_regular(fd, max_bytes)
        return os.read(fd, st.st_size)
    finally:
        os.close(fd)


def unlink_file(dir_fd: int, name: str) -> None:
    check_name(name)
    try:
        os.unlink(name, dir_fd=dir_fd)
    except FileNotFoundError:
        return


def parse_recipe(raw: str) -> dict[str, str]:
    out: dict[str, str] = {}
    if len(raw.encode()) > MAX_RECIPE:
        fail("recipe too large")
    for line in raw.splitlines():
        if not line:
            continue
        if "=" not in line:
            fail("recipe is not KEY=VALUE data")
        key, value = line.split("=", 1)
        spec = RECIPE_FIELDS.get(key)
        if spec is None or not spec.fullmatch(value):
            fail(f"invalid recipe field {key}")
        out[key] = value
    return out


def format_recipe(fields: dict[str, str]) -> bytes:
    lines = [f"{k}={fields[k]}" for k in RECIPE_FIELDS if k in fields]
    return ("\n".join(lines) + "\n").encode()


def load_recipe(dir_fd: int) -> None:
    raw = read_named(dir_fd, RECIPE_NAME, MAX_RECIPE).decode("ascii", "strict")
    fields = parse_recipe(raw)
    if not fields:
        fail("empty recipe")
    sys.stdout.write(format_recipe(fields).decode())


def save_recipe(dir_fd: int) -> None:
    raw = sys.stdin.read()
    fields = parse_recipe(raw)
    atomic_write(dir_fd, RECIPE_NAME, format_recipe(fields))


def write_pick(dir_fd: int, session: str, status: str, geo: str, shape: str) -> None:
    if not SESSION_RE.fullmatch(session):
        fail("invalid pick session", 2)
    if status not in PICK_STATUS:
        fail("invalid pick status", 2)
    if geo and not GEO_RE.fullmatch(geo):
        fail("invalid pick geometry", 2)
    if shape not in SHAPE:
        fail("invalid pick shape", 2)
    sel = (geo + ("\n" + shape if shape else "") + "\n").encode() if geo else b"\n"
    atomic_write(dir_fd, f"p-{session}.sel", sel)
    atomic_write(dir_fd, f"p-{session}.done", (status + "\n").encode())


def read_pick(dir_fd: int, session: str) -> None:
    if not SESSION_RE.fullmatch(session):
        fail("invalid pick session", 2)
    done_name = f"p-{session}.done"
    sel_name = f"p-{session}.sel"
    try:
        done_fd = os.open(done_name, OPEN_READ, dir_fd=dir_fd)
    except FileNotFoundError:
        missing()
    except OSError as e:
        fail(str(e))
    try:
        owned_regular(done_fd, MAX_PICK)
        done_raw = os.read(done_fd, MAX_PICK).decode("ascii", "strict").strip()
    finally:
        os.close(done_fd)
    if done_raw not in PICK_STATUS:
        fail("invalid pick status")
    try:
        sel_fd = os.open(sel_name, OPEN_READ, dir_fd=dir_fd)
    except FileNotFoundError:
        missing()
    except OSError as e:
        fail(str(e))
    try:
        owned_regular(sel_fd, MAX_PICK)
        sel_raw = os.read(sel_fd, MAX_PICK).decode("ascii", "strict")
    finally:
        os.close(sel_fd)
    lines = [ln for ln in sel_raw.splitlines() if ln]
    geo = lines[0] if lines else ""
    shape = lines[1] if len(lines) > 1 else ""
    if geo and not GEO_RE.fullmatch(geo):
        fail("invalid pick geometry")
    if shape not in SHAPE:
        fail("invalid pick shape")
    if done_raw == "ok" and not geo:
        fail("ok pick missing geometry")
    unlink_file(dir_fd, done_name)
    unlink_file(dir_fd, sel_name)
    sys.stdout.write(done_raw + "\n")
    if geo:
        sys.stdout.write(geo + "\n")
    if shape:
        sys.stdout.write(shape + "\n")


def set_flag(dir_fd: int, name: str) -> None:
    if name != KEYS_FLAG:
        fail("invalid flag")
    atomic_write(dir_fd, name, b"1\n")


def clear_flag(dir_fd: int, name: str) -> None:
    if name != KEYS_FLAG:
        fail("invalid flag")
    unlink_file(dir_fd, name)


def open_stock_dir() -> int:
    try:
        return os.open(STOCK_DIR, OPEN_DIR)
    except OSError as e:
        fail(f"{STOCK_DIR}: {e}")


def read_stock_filename() -> None:
    dir_fd = open_stock_dir()
    try:
        try:
            fd = os.open(STOCK_NAME, OPEN_READ, dir_fd=dir_fd)
        except FileNotFoundError:
            missing()
        except OSError as e:
            fail(str(e))
        try:
            st = owned_regular(fd, MAX_POINTER)
            raw = os.read(fd, st.st_size).decode("ascii", "strict").strip()
        finally:
            os.close(fd)
    finally:
        os.close(dir_fd)
    if not raw or "\n" in raw or ".." in raw.split("/"):
        fail("invalid recording pointer")
    if not VIDEO_RE.fullmatch(raw):
        fail("invalid recording pointer")
    try:
        vfd = os.open(raw, OPEN_READ)
    except OSError as e:
        fail(str(e))
    try:
        owned_regular(vfd, 1 << 40)
    finally:
        os.close(vfd)
    sys.stdout.write(raw + "\n")


def clear_stock_filename() -> None:
    dir_fd = open_stock_dir()
    try:
        unlink_file(dir_fd, STOCK_NAME)
    finally:
        os.close(dir_fd)


def main(argv: list[str]) -> None:
    if len(argv) < 2:
        fail("usage: runtime-io <command> ...")
    cmd = argv[1]
    if cmd == "read-stock-filename":
        read_stock_filename()
        return
    if cmd == "clear-stock-filename":
        clear_stock_filename()
        return
    dir_fd = open_runtime_dir()
    try:
        if cmd == "load-recipe":
            load_recipe(dir_fd)
        elif cmd == "save-recipe":
            save_recipe(dir_fd)
        elif cmd == "remove-recipe":
            unlink_file(dir_fd, RECIPE_NAME)
        elif cmd == "write-pick":
            if len(argv) < 5:
                fail("usage: runtime-io write-pick SESSION STATUS GEO SHAPE")
            write_pick(dir_fd, argv[2], argv[3], argv[4], argv[5] if len(argv) > 5 else "")
        elif cmd == "read-pick":
            if len(argv) < 3:
                fail("usage: runtime-io read-pick SESSION")
            read_pick(dir_fd, argv[2])
        elif cmd == "set-flag":
            if len(argv) < 3:
                fail("usage: runtime-io set-flag NAME")
            set_flag(dir_fd, argv[2])
        elif cmd == "clear-flag":
            if len(argv) < 3:
                fail("usage: runtime-io clear-flag NAME")
            clear_flag(dir_fd, argv[2])
        else:
            fail(f"unknown command {cmd}")
    finally:
        os.close(dir_fd)


if __name__ == "__main__":
    main(sys.argv)
