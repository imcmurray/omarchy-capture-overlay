#!/bin/bash
# Apply fade in/out to the saved recording. The live pip is already in the grab.
set -euo pipefail
PLUGIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck disable=SC1091
source "$PLUGIN_DIR/bin/cam-lib"

screen=$(runtime_io verify-recording "${1:-}" 2>/dev/null) || exit 0
cam_load || exit 0

notify() {
  [[ ${IANM_CAPTURE_TEST:-} == 1 ]] && return 0
  omarchy-notification-send "$@"
}

fade_in=${FADE_IN:-0}
fade_out=${FADE_OUT:-0}
fade_sec=${FADE_SEC:-2.5}
work=$screen
log="$RUNTIME/compose.log"
{
  echo "$(date '+%F %T') file=$work fade_in=$fade_in fade_out=$fade_out fade_sec=$fade_sec"
} >>"$log"
if [[ $fade_in == 1 || $fade_out == 1 ]]; then
  dur=$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "$work" 2>/dev/null || echo 0)
  fade_sec=$(awk -v d="$dur" -v f="$fade_sec" 'BEGIN {
    if (d+0 < 0.2) { print 0; exit }
    if (f*2 > d) f = d/2.5
    if (f < 0.05) f = 0.05
    printf "%.3f", f
  }')
  if awk -v f="$fade_sec" 'BEGIN { exit !(f+0 > 0) }'; then
    vf=""
    af=""
    if [[ $fade_in == 1 ]]; then
      vf="fade=t=in:st=0:d=${fade_sec}:color=black"
      af="afade=t=in:st=0:d=${fade_sec}"
    fi
    if [[ $fade_out == 1 ]]; then
      st=$(awk -v d="$dur" -v f="$fade_sec" 'BEGIN { s=d-f; if (s<0) s=0; printf "%.3f", s }')
      vf="${vf:+$vf,}fade=t=out:st=${st}:d=${fade_sec}:color=black"
      af="${af:+$af,}afade=t=out:st=${st}:d=${fade_sec}"
    fi
    faded="${work%.mp4}-fade.mp4"
    audio_args=(-an)
    if ffprobe -v error -select_streams a -show_entries stream=codec_type -of csv=p=0 "$work" 2>/dev/null | grep -q audio; then
      audio_args=(-af "$af" -c:a aac -b:a 192k)
    fi
    echo "$(date '+%F %T') vf=$vf dur=$dur" >>"$log"
    if ffmpeg -hide_banner -loglevel error -y -i "$work" -vf "format=yuv420p,$vf" "${audio_args[@]}" \
      -c:v libx264 -preset ultrafast -tune fastdecode -crf 23 -threads 0 "$faded"
    then
      mv -f "$faded" "$work"
      notify -t 4000 "Fades applied" "Fade in/out written into the saved recording."
    else
      rm -f "$faded"
      echo "$(date '+%F %T') fade ffmpeg failed" >>"$log"
      notify -u critical -t 4000 "Fade failed" "Kept the recording without fade in/out."
    fi
  fi
fi

runtime_io remove-recipe || true
