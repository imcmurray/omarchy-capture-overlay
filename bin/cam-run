#!/bin/bash
# Long-running camera pipeline. Must outlive start-cam.
# Args: device size fps fmt sidecar log
set -euo pipefail
FFMPEG=/usr/bin/ffmpeg
MPV=/usr/bin/mpv
device=${1:?}
size=${2:?}
fps=${3:?}
fmt=${4:-}
sidecar=${5:?}
log=${6:?}

fmt_args=()
[[ -n $fmt ]] && fmt_args=(-input_format "$fmt")

"$FFMPEG" -hide_banner -loglevel warning \
  -fflags nobuffer -flags low_delay -probesize 32 -analyzeduration 0 \
  -f v4l2 -video_size "$size" -framerate "$fps" "${fmt_args[@]}" \
  -thread_queue_size 2 -i "$device" \
  -map 0:v -an -pix_fmt yuv420p -f yuv4mpegpipe pipe:1 \
  -map 0:v -an -c:v libx264 -preset ultrafast -tune zerolatency -g 30 -pix_fmt yuv420p "$sidecar" \
  2>>"$log" \
| exec "$MPV" --title=ianm-cam-preview --wayland-app-id=ianm.cam-preview \
    --no-border --no-audio --no-osc --osd-level=0 --really-quiet \
    --keepaspect-window=no --hidpi-window-scale=no --force-window=immediate \
    --profile=low-latency --untimed --no-cache --video-sync=desync --framedrop=vo \
    --demuxer=y4m -
