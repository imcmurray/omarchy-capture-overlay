#!/bin/bash
# Persist grab/pip geometry and fade flags. Live preview is the QML camera.
set -euo pipefail

PLUGIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck disable=SC1091
source "$PLUGIN_DIR/bin/cam-lib"

SHAPE=${1:-rectangle}
REGION=${2:-}
FADE_IN=${3:-0}
FADE_OUT=${4:-0}
FADE_SEC=${FADE_SEC:-2.5}

"$PLUGIN_DIR/bin/stop-cam" || true

rx=0 ry=0 rw=640 rh=360
if [[ $REGION =~ ^([0-9]+)x([0-9]+)\+(-?[0-9]+)\+(-?[0-9]+)$ ]]; then
  rw=${BASH_REMATCH[1]}
  rh=${BASH_REMATCH[2]}
  rx=${BASH_REMATCH[3]}
  ry=${BASH_REMATCH[4]}
fi
cam_fill_from_region "$rx" "$ry" "$rw" "$rh"
cam_save
