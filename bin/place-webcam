#!/bin/bash
# Force the preview window to an exact box. Never adopt mpv's native size.
set -euo pipefail
PLUGIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck disable=SC1091
source "$PLUGIN_DIR/bin/cam-lib"
x=${1:?} y=${2:?} w=${3:?} h=${4:?}
cam_place "$x" "$y" "$w" "$h"
if cam_load; then
  CAM_X=$x CAM_Y=$y CAM_W=$w CAM_H=$h
  REL_X=$((CAM_X - REGION_X))
  REL_Y=$((CAM_Y - REGION_Y))
  cam_park_xy
  cam_save
fi
