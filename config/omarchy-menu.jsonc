{
  "trigger.capture.screenrecord.no-audio": {
    "icon": "",
    "label": "With no audio",
    "action": "$HOME/.config/omarchy/plugins/ianm.capture-overlay/record.sh"
  },
  "trigger.capture.screenrecord.desktop-audio": {
    "icon": "",
    "label": "With desktop audio",
    "action": "$HOME/.config/omarchy/plugins/ianm.capture-overlay/record.sh --with-desktop-audio"
  },
  "trigger.capture.screenrecord.microphone": {
    "icon": "",
    "label": "With desktop + microphone audio",
    "action": "$HOME/.config/omarchy/plugins/ianm.capture-overlay/record.sh --with-desktop-audio --with-microphone-audio"
  },
  "trigger.capture.screenrecord.webcam": {
    "icon": "",
    "label": "With desktop + microphone audio + webcam",
    "when": "omarchy-hw-webcam",
    "action": "$HOME/.config/omarchy/plugins/ianm.capture-overlay/record.sh --with-desktop-audio --with-microphone-audio --with-webcam"
  }
}
